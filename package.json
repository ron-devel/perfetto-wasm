{
  "name": "perfetto-wasm",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/vanilla -w apps/svelte",
    "dev:vanilla": "npm run dev -w apps/vanilla",
    "dev:svelte": "npm run dev -w apps/svelte",
    "check": "npm run check -w apps/svelte"
  }
}
